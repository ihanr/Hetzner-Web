# Hetzner Web Console Environment Variables
# Copy this file to .env and fill in your details

# Hetzner Cloud API Token
HETZNER_API_TOKEN=your_token_here

# Web Console Credentials (Basic Auth)
WEB_USERNAME=admin
WEB_PASSWORD=CHANGE_ME

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Cloudflare API (Optional)
CF_API_TOKEN=your_cf_token
CF_ZONE_ID=your_zone_id
